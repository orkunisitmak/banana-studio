# Cloud deployment configuration. Empty placeholders only.
# Supabase publishable/anon keys are public configuration; provider and service-role keys are server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
FAL_KEY=
EVOLINK_API_KEY=
CRON_SECRET=
# Optional administrator-only billing reports.
FAL_ADMIN_KEY=
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
# Docker self-hosting (compose.yaml). BANANA_ACCESS_TOKEN is the sign-in secret; BANANA_PUBLIC_URL is the browser address.
BANANA_ACCESS_TOKEN=
BANANA_PUBLIC_URL=
BANANA_PUBLISH_PORT=
