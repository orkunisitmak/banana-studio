# Cloud deployment configuration. Empty placeholders only.
# Supabase publishable/anon keys are public configuration; provider and service-role keys are server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenAI-compatible provider; server settings only.
# Example URL: http://localhost:20128/v1 (localhost means this server).
# Example models: cx/gpt-6.1-sol and cx/gpt-image-2.5.
LOCAL_API_BASE_URL=
LOCAL_API_KEY=
LOCAL_TEXT_MODEL=
LOCAL_IMAGE_MODEL=
# Set false to disable this provider.
LOCAL_ENABLED=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
FAL_KEY=
EVOLINK_API_KEY=
CRON_SECRET=
# Optional administrator-only billing reports.
FAL_ADMIN_KEY=
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
