SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
FAL_KEY=
EVOLINK_API_KEY=
CRON_SECRET=
# Optional administrator-only billing reports.
FAL_ADMIN_KEY=
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
# Docker self-hosting (compose.yaml, docs/en/docker.md). Run node scripts/docker-env.mjs to fill the generated secrets.
BANANA_PUBLIC_URL=
BANANA_OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_KEYS=
JWT_JWKS=
BANANA_BIND=
BANANA_PUBLISH_PORT=
