# Cloud deployment configuration. Empty placeholders only.
# Supabase publishable/anon keys are public configuration; provider and service-role keys are server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
FAL_KEY=
EVOLINK_API_KEY=
# Optional: explicit cross-origin allowlist. Same-origin works without it.
BANANA_CORS_ORIGIN=
# Optional: per-user daily generation cap. Leave empty to disable the quota.
BANANA_DAILY_GENERATION_LIMIT=
# Optional per-provider daily caps as JSON, e.g. {"openai":50,"fal":100}.
BANANA_DAILY_PROVIDER_LIMITS=
# Optional HTTPS webhook that receives quota rejection alerts.
BANANA_QUOTA_ALERT_WEBHOOK=
CRON_SECRET=
# Optional administrator-only billing reports.
FAL_ADMIN_KEY=
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
