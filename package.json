{
  "name": "banana-studio",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "audit": "node scripts/audit-public-release.mjs --history",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:database": "node scripts/test-fresh-database.mjs",
    "test:macos": "swift test --package-path desktop/macos"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "@google/genai": "1.37.0",
    "@supabase/supabase-js": "2.39.3",
    "@vercel/queue": "0.8.0",
    "jszip": "3.10.1",
    "lucide-react": "0.561.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.5",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@vercel/node": "5.10.2",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.12",
    "postcss": "8.5.32",
    "postgres": "3.4.8",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.5"
